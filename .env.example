# Skopiuj do .env i wpisz klucze. Pliku .env NIE commituj i nie wklejaj do czatu.
AIHUBMIX_API_KEY=
OPENROUTER_API_KEY=
# Bezpiecznik łącznych wydatków na AIHubMix w USD (pojedynczy model i tak musi mieć cenę wejścia ≤ 0,20 USD/1 mln tokenów)
AIHUBMIX_MAX_SPEND_USD=1.00
# Limit darmowych zapytań OpenRouter na dzień (50 dla kont bez doładowania)
OPENROUTER_DAILY_LIMIT=50
